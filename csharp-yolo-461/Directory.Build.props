<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'CSharpYolo461.OpenVino' Or '$(MSBuildProjectName)' == 'CSharpYolo461.OpenVino.Backend'">
    <BaseIntermediateOutputPath>obj\openvino\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj\openvino\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
