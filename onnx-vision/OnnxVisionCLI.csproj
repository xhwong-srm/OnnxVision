<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectName>OnnxVisionCLI</ProjectName>
    <AssemblyName>OnnxVisionCLI</AssemblyName>
    <RootNamespace>OnnxVision</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net461</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win7-x64</RuntimeIdentifier>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Cli\Program.Options.cs" />
    <Compile Include="Datasets\Program.DatasetLoading.cs" />
    <Compile Include="Datasets\Program.InputModels.cs" />
    <Compile Include="Validation\Program.ValidationMetrics.cs" />
    <Compile Include="Imaging\Program.ImageLoading.cs" />
    <Compile Include="Reporting\Program.Reporting.cs" />
    <Compile Include="Reporting\Program.RocPoint.cs" />
    <ProjectReference Include="OnnxVision\OnnxVision.Sdk.csproj" />
    <Reference Include="Open_eVision_NetApi_22_12">
      <HintPath>C:\VisionRef64\Open_eVision_NetApi_22_12.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
