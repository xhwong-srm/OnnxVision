<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win7-x64</RuntimeIdentifier>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>OnnxVision.OpenVino.Backend</AssemblyName>
    <BaseOutputPath>bin\openvino\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ImageClassifier.cs" />
    <Compile Include="ObjectDetector.cs" />
    <PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Version="1.24.1" />
    <Reference Include="Open_eVision_NetApi_22_12">
      <HintPath>C:\VisionRef64\Open_eVision_NetApi_22_12.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
